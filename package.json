{
  "name": "@paxalabs/mcp",
  "version": "0.1.0-beta.4",
  "mcpName": "com.paxalabs/mcp",
  "description": "Official MCP server for the Paxa Labs API: Thai/English text to speech with local playback, translation to Thai, and document OCR.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "paxalabs-mcp": "dist/index.js",
    "paxa-say": "dist/say.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "mcpb": "node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tts",
    "text-to-speech",
    "thai",
    "translation",
    "ocr",
    "paxa"
  ],
  "homepage": "https://paxalabs.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paxalabs/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/paxalabs/mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
